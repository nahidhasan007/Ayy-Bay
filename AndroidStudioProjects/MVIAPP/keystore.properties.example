# Copy this file to keystore.properties (git-ignored) and fill in real values
# once you've generated an upload keystore, e.g.:
#
#   keytool -genkeypair -v -keystore release-jibon.jks -alias jibon -keyalg RSA \
#     -keysize 2048 -validity 10000
#
# Keep release-jibon.jks and these passwords somewhere safe outside git --
# losing them means you can never publish an update under the same app listing.

storeFile=/absolute/path/to/release-jibon.jks
storePassword=CHANGE_ME
keyAlias=jibon
keyPassword=CHANGE_ME
