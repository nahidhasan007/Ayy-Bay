rt kotlinx.coroutines.CoroutineScope\nimport kotlinx.coroutines.Dispatchers\nimport kotlinx.coroutines.Job\nimport kotlinx.coroutines.delay\nimport kotlinx.coroutines.launch\nimport java.util.Locale\n\n/**\n * ForegroundService responsible for playing Adhan audio.\n *\n * CRITICAL: Uses USAGE_ALARM audio attribute to ensure Adhan plays\n * even when phone is in Doze mode, silent mode, or on low priority.\n *\n * WHY FOREGROUND SERVICE?\n * - Android 12+ background execution limits would block audio playback\n * - Foreground service ensures app stays alive during Adhan\n * - Audio playback can continue even if app is in background\n * - Works reliably in Doze mode and when phone is locked\n */\nclass AdhanForegroundService : Service() {\n\n    companion object {\n        private const val CHANNEL_ID \u003d \&quot;adhan_playback_channel\&quot;\n        private const val CHANNEL_NAME \u003d \&quot;Adhan Playback\&quot;\n        private const val NOTIFICATION_ID \u003d 2001\n\n        private const val EXTRA_PRAYER_NAME \u003d \&quot;prayer_name\&quot;\n        private const val EXTRA_ADHAN_DURATION \u003d \&quot;adhan_duration\&quot;\n\n        const val ACTION_START_ADHAN \u003d \&quot;com.ayybay.app.action.START_ADHAN\&quot;\n        const val ACTION_STOP_ADHAN \u003d \&quot;com.ayybay.app.action.STOP_ADHAN\&quot;\n\n        fun startAdhan(context: Context, prayerName: String, durationSeconds: Int \u003d 90) {\n            val intent \u003d Intent(context, AdhanForegroundService::class.java).apply {\n                action \u003d ACTION_START_ADHAN\n                putExtra(EXTRA_PRAYER_NAME, prayerName)\n                putExtra(EXTRA_ADHAN_DURATION, durationSeconds)\n            }\n\n            if (Build.VERSION.SDK_INT \u003e\u003d Build.VERSION_CODES.O) {\n                context.startForegroundService(intent)\n            } else {\n                context.startService(intent)\n            }\n        }\n\n        fun stopAdhan(context: Context) {\n            val intent \u003d Intent(context, AdhanForegroundService::class.java).apply {\n                action \u003d ACTION_STOP_ADHAN\n            }\n            context.startService(intent)\n        }\n    }\n\n    private var mediaPlayer: MediaPlayer? \u003d null\n    private var audioFocusRequest: AudioFocusRequest? \u003d null\n    private val serviceScope \u003d CoroutineScope(Job() + Dispatchers.Main)\n    private var isPlaying \u003d false\n\n    override fun onBind(intent: Intent?): IBinder? \u003d null\n\n    override fun onCreate() {\n        super.onCreate()\n        createNotificationChannel()\n    }\n\n    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {\n        val action \u003d intent?.action\n\n        when (action) {\n            ACTION_START_ADHAN -\u003e {\n                val prayerName \u003d intent.getStringExtra(EXTRA_PRAYER_NAME) ?: \&quot;Prayer\&quot;\n                val durationSeconds \u003d intent.getIntExtra(EXTRA_ADHAN_DURATION, 90)\n                startAdhanPlayback(prayerName, durationSeconds)\n            }\n\n            ACTION_STOP_ADHAN -\u003e {\n                stopAdhanPlayback()\n            }\n        }\n\n        return START_NOT_STICKY\n    }\n\n    private fun startAdhanPlayback(prayerName: String, durationSeconds: Int) {\n        if (isPlaying) return\n\n        // Start foreground service with notification FIRST\n        val notification \u003d createAdhanNotification(prayerName)\n        startForeground(NOTIFICATION_ID, notification)\n\n        // Request audio focus with USAGE_ALARM\n        requestAudioFocus()\n\n        // Initialize and start MediaPlayer with guaranteed audio\n        val player \u003d MediaPlayer()\n        mediaPlayer \u003d player\n\n        // CRITICAL: USAGE_ALARM ensures playback even in Doze/Silent mode\n        val audioAttributes \u003d AudioAttributes.Builder()\n            .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)\n            .setUsage(AudioAttributes.USAGE_ALARM)\n            .build()\n\n        player.setAudioAttributes(audioAttributes)\n        player.setLooping(true) // Loop to ensure continuous audio\n\n        try {\n            // Try 1: Load Adhan from raw resources\n            val adhanUri \u003d getAdhanUri()\n\n            if (adhanUri !\u003d null) {\n                try {\n                    player.setDataSource(applicationContext, adhanUri)\n                    player.prepareAsync()\n\n                    player.setOnPreparedListener {\n                        player.start()\n                        isPlaying \u003d true\n                    }\n\n                    player.setOnErrorListener { mp, what, extra -\u003e\n                        // Try fallback if custom Adhan fails\n                        playSystemAlarmSound(prayerName)\n                        true\n                    }\n\n                    player.setOnCompletionListener {\n                        releaseMediaPlayer()\n                        stopSelf()\n                    }\n                } catch (e: Exception) {\n                    // Adhan file load failed, use system sound\n                    playSystemAlarmSound(prayerName)\n                }\n            } else {\n                // No Adhan file, use system sound directly\n                playSystemAlarmSound(prayerName)\n            }\n        } catch (e: Exception) {\n            e.printStackTrace()\n            // Final fallback - ensure something plays\n            playSystemAlarmSound(prayerName)\n        }\n\n        // Safety timeout - stop after expected duration\n        serviceScope.launch {\n            delay((durationSeconds + 10) * 1000L)\n            if (isPlaying) {\n                stopAdhanPlayback()\n            }\n        }\n    }\n\n    /**\n     * Play system alarm sound as guaranteed fallback\n     * This ALWAYS works regardless of custom files\n     */\n    @RequiresApi(Build.VERSION_CODES.O)\n    private fun playSystemAlarmSound(prayerName: String) {\n        try {\n            mediaPlayer?.release() // Clean up previous instance\n\n            val alarmUri \u003d Settings.System.getActualDefaultRingtoneUri(\n                applicationContext,\n                Settings.System.DEFAULT_ALARM_ALERT_URI\n            )\n            val player \u003d MediaPlayer().apply {\n                setAudioAttributes(\n                    AudioAttributes.Builder()\n                        .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)\n                        .setUsage(AudioAttributes.USAGE_ALARM)\n                        .build()\n                )\n                setLooping(true)\n\n                setDataSource(\n                    applicationContext,\n                    alarmUri ?: Settings.System.DEFAULT_ALARM_ALERT_URI\n                )\n\n                prepareAsync()\n\n                setOnPreparedListener { mp -\u003e\n                    mp.start()\n                    isPlaying \u003d true\n                }\n\n                setOnErrorListener { _, _, _ -\u003e\n                    releaseMediaPlayer()\n                    stopSelf()\n                    true\n                }\n\n                setOnCompletionListener {\n                    releaseMediaPlayer()\n                    stopSelf()\n                }\n            }\n\n            mediaPlayer \u003d player // Store new instance\n\n        } catch (e: Exception) {\n            e.printStackTrace()\n            // Ultimate fallback - vibration\n            fallbackToVibration()\n        }\n    }\n\n    /**\n     * Vibration fallback when audio fails completely\n     */\n    @RequiresApi(Build.VERSION_CODES.O)\n    private fun fallbackToVibration() {\n        // Callers must check/request VIBRATE permission before calling this method!\n        if (Build.VERSION.SDK_INT \u003e\u003d Build.VERSION_CODES.S) {\n            val vibratorManager \u003d\n                getSystemService(Context.VIBRATOR_MANAGER_SERVICE) as? VibratorManager\n            val vibrator \u003d vibratorManager?.defaultVibrator\n            vibrator?.vibrate(\n                VibrationEffect.createWaveform(\n                    longArrayOf(0, 200, 100, 200, 100, 200, 500, 200, 100, 200, 100, 200, 500),\n                    0\n                )\n            )\n        } else {\n            @Suppress(\&quot;DEPRECATION\&quot;)\n            (getSystemService(Context.VIBRATOR_SERVICE) as? Vibrator)?.vibrate(\n                VibrationEffect.createWaveform(\n                    longArrayOf(0, 200, 100, 200, 100, 200, 500, 200, 100, 200, 100, 200, 500),\n                    0\n                )\n            )\n        }\n\n        // Keep service running for vibration duration\n        serviceScope.launch {\n            delay(3000)\n            stopAdhanPlayback()\n        }\n    }\n\n    private fun stopAdhanPlayback() {\n        releaseMediaPlayer()\n        isPlaying \u003d false\n        stopForeground(STOP_FOREGROUND_REMOVE)\n        stopSelf()\n    }\n\n    private fun requestAudioFocus() {\n        val audioManager \u003d getSystemService(Context.AUDIO_SERVICE) as AudioManager\n\n        if (Build.VERSION.SDK_INT \u003e\u003d Build.VERSION_CODES.O) {\n            audioFocusRequest \u003d AudioFocusRequest.Builder(AudioManager.AUDIOFOCUS_GAIN)\n                .setAudioAttributes(\n                    AudioAttributes.Builder()\n                        .setContentType(AudioAttributes.CONTENT_TYPE_MUSIC)\n                        .setUsage(AudioAttributes.USAGE_ALARM)\n                        .build()\n                )\n                .setAcceptsDelayedFocusGain(true)\n                .setOnAudioFocusChangeListener { focusChange -\u003e\n                    when (focusChange) {\n                        AudioManager.AUDIOFOCUS_LOSS -\u003e stopAdhanPlayback()\n                    }\n                }\n                .build()\n\n            audioManager.requestAudioFocus(audioFocusRequest!!)\n        } else {\n            @Suppress(\&quot;DEPRECATION\&quot;)\n            audioManager.requestAudioFocus(\n                { _ -\u003e },\n                AudioManager.STREAM_ALARM,\n                AudioManager.AUDIOFOCUS_GAIN\n            )\n        }\n    }\n\n    private fun releaseMediaPlayer() {\n        mediaPlayer?.apply {\n            if (isPlaying) {\n                stop()\n            }\n            reset()\n            release()\n        }\n        mediaPlayer \u003d null\n        isPlaying \u003d false\n\n        // Abandon audio focus\n        val audioManager \u003d getSystemService(Context.AUDIO_SERVICE) as AudioManager\n        if (Build.VERSION.SDK_INT \u003e\u003d Build.VERSION_CODES.O) {\n            audioFocusRequest?.let {\n                audioManager.abandonAudioFocusRequest(it)\n            }\n        } else {\n            @Suppress(\&quot;DEPRECATION\&quot;)\n            audioManager.abandonAudioFocus { }\n        }\n    }\n\n    private fun getAdhanUri(): Uri? {\n        // Priority 1: Try raw resource (recommended for app distribution)\n        // You should place your Adhan audio file at: app/src/main/res/raw/adhan.mp3\n        // Download any Adhan MP3 file and rename it to \u0027adhan.mp3\u0027\n        return try {\n            Uri.parse(\&quot;android.resource://${packageName}/raw/adhan\&quot;)\n        } catch (e: Exception) {\n            null\n        }\n    }\n\n    private fun createNotificationChannel() {\n        if (Build.VERSION.SDK_INT \u003e\u003d Build.VERSION_CODES.O) {\n            val channel \u003d NotificationChannel(\n                CHANNEL_ID,\n                CHANNEL_NAME,\n                NotificationManager.IMPORTANCE_HIGH\n            ).apply {\n                description \u003d \&quot;Adhan playback notification\&quot;\n                setShowBadge(false)\n                setSound(null, null)\n            }\n\n            val notificationManager \u003d\n                getSystemService(Context.NOTIFICATION_SERVICE) as Notifica