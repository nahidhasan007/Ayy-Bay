ra(EXTRA_PRAYER_NAME, prayerName)\\n                putExtra(EXTRA_ADHAN_DURATION, durationSeconds)\\n            }\\n            \\n            if (Build.VERSION.SDK_INT \u003e\u003d Build.VERSION_CODES.O) {\\n                context.startForegroundService(intent)\\n            } else {\\n                context.startService(intent)\\n            }\\n        }\\n        \\n        fun stopAdhan(context: Context) {\\n            val intent \u003d Intent(context, AdhanForegroundService::class.java).apply {\\n                action \u003d ACTION_STOP_ADHAN\\n            }\\n            context.startService(intent)\\n        }\\n    }\\n    \\n    private var mediaPlayer: MediaPlayer? \u003d null\\n    private var audioFocusRequest: AudioFocusRequest? \u003d null\\n    private var serviceScope \u003d CoroutineScope(Job() + Dispatchers.Main)\\n    private var isPlaying \u003d false\\n    \\n    override fun onBind(intent: Intent?): IBinder? \u003d null\\n    \\n    override fun onCreate() {\\n        super.onCreate()\\n        createNotificationChannel()\\n    }\\n    \\n    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {\\n        val action \u003d intent?.action\\n        \\n        when (action) {\\n            ACTION_START_ADHAN -\u003e {\\n                val prayerName \u003d intent.getStringExtra(EXTRA_PRAYER_NAME) ?: \\\&quot;Prayer\\\&quot;\\n                val durationSeconds \u003d intent.getIntExtra(EXTRA_ADHAN_DURATION, 90)\\n                startAdhanPlayback(prayerName, durationSeconds)\\n            }\\n            ACTION_STOP_ADHAN -\u003e {\\n                stopAdhanPlayback()\\n            }\\n        }\\n        \\n        return START_NOT_STICKY\\n    }\\n    \\n    private fun startAdhanPlayback(prayerName: String, durationSeconds: Int) {\\n        if (isPlaying) return\\n        \\n        // Start foreground service with notification\\n        val notification \u003d createAdhanNotification(prayerName)\\n        startForeground(NOTIFICATION_ID, notification)\\n        \\n        // Request audio focus with USAGE_ALARM\\n        requestAudioFocus()\\n        \\n        // Initialize and start MediaPlayer\\n        mediaPlayer \u003d MediaPlayer().apply {\\n            // CRITICAL: USAGE_ALARM ensures playback even in Doze/Silent mode\\n            val audioAttributes \u003d AudioAttributes.Builder()\\n                .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)\\n                .setUsage(AudioAttributes.USAGE_ALARM)\\n                .build()\\n            \\n            setAudioAttributes(audioAttributes)\\n            setLooping(false)\\n            \\n            try {\\n                // Try to load Adhan audio from raw resources\\n                // You should place your Adhan audio file at: app/src/main/res/raw/adhan.mp3\\n                // Alternatively, load from internal storage\\n                val adhanUri \u003d getAdhanUri()\\n                \\n                if (adhanUri !\u003d null) {\\n                    setDataSource(applicationContext, adhanUri)\\n                    prepareAsync()\\n                    \\n                    setOnPreparedListener {\\n                        start()\\n                        isPlaying \u003d true\\n                    }\\n                    \\n                    setOnErrorListener { _, _, _ -\u003e\\n                        releaseMediaPlayer()\\n                        stopSelf()\\n                        true\\n                    }\\n                    \\n                    setOnCompletionListener {\\n                        releaseMediaPlayer()\\n                        stopSelf()\\n                    }\\n                } else {\\n                    // Fallback: Use system notification sound if adhan file not found\\n                    val notification \u003d getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager\\n                    releaseMediaPlayer()\\n                    